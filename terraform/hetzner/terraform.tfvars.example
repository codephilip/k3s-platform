# Optional Hetzner Terraform: one server + firewall (22, 80, 443, 6443).
# Copy to terraform.tfvars and set your values. Do not commit terraform.tfvars.
#
# Required:
hcloud_token   = "" # Hetzner Cloud API token, or set HCLOUD_TOKEN env var
ssh_public_key = "" # e.g. contents of ~/.ssh/id_ed25519.pub

# Optional (defaults shown):
# server_name = "k3s-node"
# server_type = "cx22"
# location    = "fsn1"
# image       = "ubuntu-22.04"

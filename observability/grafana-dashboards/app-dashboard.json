{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(app_http_requests_total[5m]) or vector(0)",
          "legendFormat": "{{ method }} {{ path }}",
          "refId": "A"
        }
      ],
      "title": "Request rate (app)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=~\".*app.*\"} or container_memory_working_set_bytes{namespace=~\".*-apps\", pod=~\".*app.*\"}",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "title": "Memory (app)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=~\".*app.*\"}[5m]) * 100 or rate(container_cpu_usage_seconds_total{namespace=~\".*-apps\", pod=~\".*app.*\"}[5m]) * 100",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "title": "CPU % (app)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [
        {
          "expr": "count(kube_pod_status_ready{namespace=~\".*-apps\", pod=~\".*app.*\"} == 1) or count(up{job=~\".*app.*\"} == 1)",
          "legendFormat": "Pods ready",
          "refId": "A"
        }
      ],
      "title": "Pods ready",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["app", "platform"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "App",
  "uid": "app",
  "version": 1,
  "weekStart": ""
}
